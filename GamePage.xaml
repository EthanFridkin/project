<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Project.GamePage"
             BackgroundColor="#001529">

    <Grid RowDefinitions="Auto, Auto, *, Auto"
          Padding="10,10,10,0">

        <Label Grid.Row="0"
               Text="לוח המשחק"
               TextColor="White"
               FontSize="22"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,0,0,4"/>

        <BoxView Grid.Row="0"
                 HeightRequest="1"
                 BackgroundColor="#4488AA"
                 VerticalOptions="End"/>

        <Label x:Name="StatusLabel"
               Grid.Row="1"
               Text="הנח את הצוללות על הלוח ולחץ התחל"
               TextColor="#FFD700"
               FontSize="13"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,4,0,4"/>

        <Grid Grid.Row="2"
              ColumnDefinitions="*, Auto, *"
              Margin="0,4,0,4"
              VerticalOptions="Start">

            <BoxView Grid.Column="1"
                     WidthRequest="3"
                     BackgroundColor="#FFD700"
                     HorizontalOptions="Center"/>

            <StackLayout Grid.Column="0" Spacing="0" VerticalOptions="Start">
                <Label Text="השחקן שלי"
                       TextColor="#009ADA"
                       FontSize="14"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Margin="0,4,0,4"/>
                <AbsoluteLayout x:Name="PlayerArea"
                                HorizontalOptions="Start"/>
            </StackLayout>

            <StackLayout Grid.Column="2" Spacing="0" VerticalOptions="Start">
                <Label x:Name="AIAreaLabel"
                       Text="יריב AI"
                       TextColor="#AA3333"
                       FontSize="14"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Margin="0,4,0,4"/>
                <AbsoluteLayout x:Name="AIArea"
                                HorizontalOptions="Start"/>
            </StackLayout>

        </Grid>

        <Grid Grid.Row="3"
              ColumnDefinitions="Auto, *, Auto, Auto"
              Margin="0,8,0,8">

            <Frame Grid.Column="0"
                   CornerRadius="25"
                   WidthRequest="50"
                   HeightRequest="50"
                   BackgroundColor="#007ACC"
                   HasShadow="True">
                <Label Text="💬"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontSize="24"/>
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChatIconTapped"/>
                </Frame.GestureRecognizers>
            </Frame>

            <Button x:Name="StartGameBtn"
                    Grid.Column="2"
                    Text="התחל משחק"
                    FontSize="16"
                    FontAttributes="Bold"
                    BackgroundColor="#00AA44"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    Padding="12,0"
                    Clicked="StartGame_Click"/>

            <Label x:Name="TimerLabel"
                   Grid.Column="3"
                   Text="30"
                   TextColor="Red"
                   FontAttributes="Bold"
                   FontSize="28"
                   HorizontalOptions="End"
                   VerticalOptions="Center"
                   Margin="10,0,0,0"/>

        </Grid>

        <!-- Toast -->
        <Frame x:Name="ToastFrame"
               Grid.Row="2"
               BackgroundColor="#CC000000"
               CornerRadius="20"
               Padding="20,10"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Margin="0,20,0,0"
               IsVisible="False">
            <Label x:Name="ToastLabel"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
        </Frame>

        <!-- חלון צ'אט מתוקן -->
        <Frame x:Name="ChatWindow"
               Grid.Row="2"
               BackgroundColor="#222"
               CornerRadius="12"
               Padding="10"
               WidthRequest="280"
               HeightRequest="320"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Margin="0,0,0,10"
               IsVisible="False"
               Opacity="0.97">
            <Grid RowDefinitions="Auto, *, Auto, Auto">

                <Label Grid.Row="0"
                       Text="צ'אט"
                       TextColor="Aqua"
                       FontAttributes="Bold"
                       FontSize="18"
                       HorizontalOptions="Center"
                       Margin="0,0,0,6"/>

                <ScrollView Grid.Row="1"
                            x:Name="ChatScrollView">
                    <Label x:Name="ChatMessages"
                           TextColor="White"
                           FontSize="13"
                           VerticalOptions="Start"/>
                </ScrollView>

                <BoxView Grid.Row="2"
                         HeightRequest="1"
                         BackgroundColor="#444"
                         Margin="0,6,0,6"/>

                <Grid Grid.Row="3"
                      ColumnDefinitions="*, Auto">
                    <Entry Grid.Column="0"
                           x:Name="ChatEntry"
                           Placeholder="כתוב הודעה..."
                           TextColor="Black"
                           BackgroundColor="White"
                           FontSize="13"
                           HeightRequest="40"/>
                    <Button Grid.Column="1"
                            Text="שלח"
                            FontSize="13"
                            BackgroundColor="#007ACC"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="40"
                            Padding="8,0"
                            Clicked="SendMessage_Click"/>
                </Grid>

            </Grid>
        </Frame>

    </Grid>
</ContentPage>