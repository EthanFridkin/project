<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Project.MainPage"
             BackgroundColor="#001529">

    <VerticalStackLayout Spacing="16"
                         Padding="40"
                         VerticalOptions="Center">

        <Label Text="צוללות"
               TextColor="White"
               FontSize="42"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,0,0,30"/>

        <Button Text="התחברות משתמש"
                FontSize="18"
                FontAttributes="Bold"
                BackgroundColor="#007ACC"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="55"
                Clicked="UserLogin_Click"/>

        <Button Text="כניסה כאורח"
                FontSize="18"
                FontAttributes="Bold"
                BackgroundColor="#444"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="55"
                Clicked="GuestLogin_Click"/>

        <Button Text="הוראות"
                FontSize="18"
                FontAttributes="Bold"
                BackgroundColor="#005588"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="55"
                Clicked="Instructions_Click"/>

    </VerticalStackLayout>
</ContentPage>